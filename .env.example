# --- Database ---
DATABASE_URL=postgresql://axi:axi@localhost:5432/axi

# --- Auth ---
# Random 32+ char secret used to sign session JWTs.
SESSION_SECRET=change-me-to-a-long-random-string

# --- AI (Google Gemini) ---
# AI_MODE=gemini | mock  (mock returns deterministic grades, no API calls)
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- AI tuning (optional) ---
# Which grading prompt to use: V2 (calibrated, default) or V1 (original).
AI_PROMPT_VERSION=V2
# Bounded retry budget per grading (1 = no retry; never infinite).
GEMINI_MAX_ATTEMPTS=3
# Timeout for a single Gemini request (ms).
GEMINI_TIMEOUT_MS=60000
# Base delay for exponential backoff between retries (ms).
GEMINI_RETRY_BASE_MS=800
# Expose AI diagnostics (model/prompt/retries/latency) in responses & logs.
# ALWAYS off in production. Outside production leave empty to enable.
AI_DEBUG=

# --- SMS ---
# SMS_MODE=mock | live  (mock logs the code to server console)
SMS_MODE=mock

# --- Payments ---
# PAYMENT_MODE=mock | click | payme
PAYMENT_MODE=mock

# --- Reading / Listening (shared objective engine) ---
# Optional JSON override of the raw-score (out of 40) -> band tables.
# Example: {"READING":[{"min":30,"band":7.0},{"min":0,"band":4.0}]}
# Malformed values are ignored and the built-in IELTS tables are used.
BAND_TABLE_OVERRIDE=

# --- Speaking ---
# Hard cap for a single recording (seconds) and upload size (MB).
SPEAKING_MAX_RECORDING_SECONDS=300
SPEAKING_MAX_UPLOAD_MB=25

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Minimum words before a Task 2 essay can be graded without warning.
WRITING_MIN_WORDS=250
# Set to "true" to block submissions under the minimum word count.
WRITING_ENFORCE_MIN_WORDS=false
