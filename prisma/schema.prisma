// AXI — AI-powered IELTS preparation platform
// Database schema. Writing module is fully implemented; other modules
// (Reading, Listening, Speaking) plug into the same Submission model
// via the `module` enum later.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Module {
  WRITING
  READING
  LISTENING
  SPEAKING
}

enum SubmissionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SpeakingInterviewState {
  PREPARING
  PART_1
  PART_2
  PART_3
  UPLOADING
  TRANSCRIBING
  EVALUATING
  COMPLETED
  FAILED
}

enum PaymentProvider {
  CLICK
  PAYME
  MOCK
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELLED
}

// ---------------------------------------------------------------- testing

/**
 * Extensible question kinds shared by Reading and Listening.
 */
enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  MATCHING
  SENTENCE_COMPLETION
  SHORT_ANSWER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  FAILED
}

enum AudioKind {
  LISTENING_SECTION
  SPEAKING_RECORDING
}

model User {
  id              String    @id @default(cuid())
  phone           String    @unique
  name            String
  passwordHash    String
  role            Role      @default(USER)
  // Future auth fields — kept nullable so email/oauth can be added later.
  email           String?   @unique
  phoneVerifiedAt DateTime?
  locale          String    @default("uz")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  submissions        Submission[]
  payments           Payment[]
  testAttempts       TestAttempt[]
  audioAssets        AudioAsset[]
  speakingInterviews SpeakingInterview[]
}

model SmsCode {
  id        String    @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone])
}

model Submission {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  module              Module           @default(WRITING)
  testType            String           @default("TASK_2")
  question            String
  essay               String
  wordCount           Int
  status              SubmissionStatus @default(PENDING)
  processingStartedAt DateTime?
  idempotencyKey      String?
  requestFingerprint  String?
  createdAt           DateTime         @default(now())

  score             Score?
  feedback          Feedback?
  errors            EssayError[]
  aiEvaluations     AiEvaluation[]
  speakingResult    SpeakingResult?
  recordings        AudioAsset[]
  speakingInterview SpeakingInterview?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model Score {
  id                String     @id @default(cuid())
  submissionId      String     @unique
  submission        Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  taskResponse      Float
  coherenceCohesion Float
  lexicalResource   Float
  grammar           Float
  overall           Float
  createdAt         DateTime   @default(now())
}

model Feedback {
  id                    String     @id @default(cuid())
  submissionId          String     @unique
  submission            Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  summary               String
  // Per-criterion explanations for the result page.
  taskResponseNote      String     @default("")
  coherenceCohesionNote String     @default("")
  lexicalResourceNote   String     @default("")
  grammarNote           String     @default("")
  strengths             String[]
  weaknesses            String[]
  improvements          String[]
  createdAt             DateTime   @default(now())
}

model EssayError {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  category     String
  originalText String
  correction   String
  explanation  String
  // Repeated errors are stored once as a representative example.
  frequency    Int?       @default(1)
  isSystematic Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([submissionId])
}

// Raw AI responses for debugging and future model comparison.
model AiEvaluation {
  id               String     @id @default(cuid())
  submissionId     String
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  provider         String
  model            String
  promptVersion    String
  rawResponse      String
  latencyMs        Int?
  success          Boolean    @default(true)
  // Reliability / cost metadata.
  attempts         Int?       @default(1)
  retryCount       Int?       @default(0)
  validationStatus String?    @default("VALID")
  inputTokens      Int?
  outputTokens     Int?
  // Non-fatal operator observations (see src/lib/ai/warnings.ts).
  warnings         String[]   @default([])
  createdAt        DateTime   @default(now())

  @@index([submissionId])
}

// Payment architecture placeholder for Click / Payme.
model Payment {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   PaymentProvider
  amount     Int
  currency   String          @default("UZS")
  status     PaymentStatus   @default(CREATED)
  externalId String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId])
}

// ================================================================
// Shared test engine (Reading + Listening + Speaking prompts)
// ================================================================

/**
 * A test paper. `module` distinguishes READING / LISTENING / SPEAKING so one
 * engine and one authoring model serve every module.
 */
model Test {
  id              String   @id @default(cuid())
  module          Module
  title           String
  description     String?
  durationMinutes Int      @default(60)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sections           TestSection[]
  attempts           TestAttempt[]
  speakingInterviews SpeakingInterview[]

  @@index([module, isPublished])
}

model TestSection {
  id           String      @id @default(cuid())
  testId       String
  test         Test        @relation(fields: [testId], references: [id], onDelete: Cascade)
  order        Int
  title        String
  instructions String?
  /**
   * Reading only: the passage body.
   */
  passage      String?
  /**
   * Listening only: audio is referenced as a file, never stored as binary here.
   */
  audioAssetId String?     @unique
  audioAsset   AudioAsset? @relation("SectionAudio", fields: [audioAssetId], references: [id], onDelete: SetNull)

  questions TestQuestion[]

  @@index([testId, order])
}

model TestQuestion {
  id          String       @id @default(cuid())
  sectionId   String
  section     TestSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order       Int
  /**
   * Display number (for example 1..40).
   */
  number      Int
  type        QuestionType
  prompt      String
  /**
   * Answer options for choice/matching questions: [{ value, label }].
   */
  options     Json?
  /**
   * Canonical accepted answers: { answers: string[] }. Never sent before grading.
   */
  answer      Json
  explanation String?
  points      Int          @default(1)
  /**
   * Question-type specific extras (word limits, recording windows, ...).
   */
  meta        Json?
  /**
   * Questions sharing one option list (matching groups) share a groupId.
   */
  groupId     String?

  answers TestAnswer[]

  @@index([sectionId, order])
}

/**
 * Audio lives in a file/object store; the database keeps only metadata and the
 * storage URL so it never grows binary payloads.
 */
model AudioAsset {
  id              String      @id @default(cuid())
  kind            AudioKind
  storageKey      String      @unique
  url             String
  mimeType        String
  sizeBytes       Int?
  durationSeconds Int?
  /**
   * Owner of user recordings (speaking); null for published test audio.
   */
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionId    String?
  submission      Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  speakingPart    Int?
  createdAt       DateTime    @default(now())

  sections TestSection[] @relation("SectionAudio")

  @@unique([submissionId, speakingPart])
  @@index([userId])
  @@index([submissionId])
}

/**
 * One user's attempt at a test.
 */
model TestAttempt {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId           String
  test             Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  module           Module
  status           AttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  timeSpentSeconds Int?
  rawScore         Int?
  maxScore         Int?
  band             Float?
  createdAt        DateTime      @default(now())

  answers TestAnswer[]

  @@index([userId, createdAt])
  @@index([testId])
}

model TestAnswer {
  id            String       @id @default(cuid())
  attemptId     String
  attempt       TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /**
   * Raw learner response, shaped by the question type.
   */
  response      Json
  isCorrect     Boolean?
  awardedPoints Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ================================================================
// Speaking (audio -> transcription -> AI evaluation)
// ================================================================

model SpeakingResult {
  id                    String     @id @default(cuid())
  submissionId          String     @unique
  submission            Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /**
   * Transcript produced by the transcription provider (mock in development).
   */
  transcript            String
  transcriptionProvider String
  transcriptionModel    String?
  fluencyCoherence      Float
  lexicalResource       Float
  grammar               Float
  pronunciation         Float
  overall               Float
  summary               String
  strengths             String[]
  weaknesses            String[]
  improvements          String[]
  aiProvider            String
  aiModel               String
  promptVersion         String
  /**
   * True when the evaluation came from MockSpeakingGrader, never a real model.
   */
  isMock                Boolean    @default(true)
  rawResponse           String?
  createdAt             DateTime   @default(now())
}

/**
 * Durable, server-authoritative state for a complete three-part interview.
 */
model SpeakingInterview {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId          String
  test            Test                   @relation(fields: [testId], references: [id], onDelete: Cascade)
  submissionId    String                 @unique
  submission      Submission             @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  state           SpeakingInterviewState @default(PREPARING)
  currentPart     Int                    @default(1)
  currentPromptId String
  startedAt       DateTime               @default(now())
  stateStartedAt  DateTime               @default(now())
  completedAt     DateTime?
  failureReason   String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([userId, testId, createdAt])
  @@index([state, stateStartedAt])
}
